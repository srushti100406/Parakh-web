# PARAKH Admin Web — Environment Variables
# Copy to .env and adjust for your deployment.
# These are BROWSER-SAFE values only.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL here.

# Base URL for API calls. Leave empty when the dev proxy in vite.config.js
# is in use (requests to /api are forwarded to localhost:8000).
# For production, set this to your deployed backend URL:
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
